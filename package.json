{
  "name": "sunfai-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && node scripts/optimize-images.mjs && node scripts/check-mascot.mjs && next build && node scripts/postbuild.mjs",
    "build:plain": "next build",
    "preview": "npx serve out -l 4173",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/optimize-images.mjs",
    "social": "node scripts/fetch-social.mjs",
    "lmo:export": "tsx scripts/export-lmo-review.mts",
    "lmo:import": "tsx scripts/import-lmo-review.mts",
    "test:mobile": "playwright test -c playwright.mobile.config.ts",
    "test:fidelity": "playwright test -c playwright.fidelity.config.ts",
    "check:links": "node scripts/check-links.mjs",
    "docs:fetch": "node scripts/fetch-documents.mjs",
    "routes": "node scripts/gen-routes.mjs",
    "backgrounds": "node scripts/gen-backgrounds.mjs",
    "v3:compare": "node scripts/v3-compare.mjs",
    "qa:people": "node scripts/check-people-edges.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
